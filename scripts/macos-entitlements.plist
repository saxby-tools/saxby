<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Entitlements for the signed macOS binaries (scripts/sign-macos.js).

    Notarization requires the hardened runtime, and the hardened
    runtime forbids executable memory unless the binary says it needs
    it. A Deno binary is V8, which compiles JavaScript to machine code
    at run time; signed without these two, `saxby` aborts at start
    with "Failed to reserve virtual memory for CodeRange". Both are
    accepted by the notary service. Nothing else is granted.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
