{
    "workspace": [
        "./packages/cli",
        "./packages/core",
        "./packages/llm-router",
        "./packages/vram-mac-guard"
    ],
    "imports": {
        "@std/path": "jsr:@std/path@1.0.6",
        "@cliffy/command": "jsr:@cliffy/command@1.0.0-rc.4",
        "plist": "npm:plist@3.1.0"
    },
    "fmt": {
        "useTabs": false,
        "indentWidth": 4,
        "proseWrap": "preserve",
        "exclude": ["**/node_modules/", "**/*.sh"]
    },
    "lint": {
        "rules": {
            "tags": ["recommended"]
        },
        "exclude": ["**/node_modules/"]
    }
}
