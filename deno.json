{
    "workspace": [
        "./packages/cli",
        "./packages/core",
        "./packages/llm-router",
        "./packages/vram-guard-mac"
    ],
    "imports": {
        "@cliffy/prompt": "jsr:@cliffy/prompt@^1.2.1",
        "@hono/hono": "jsr:@hono/hono@^4.13.1",
        "@lezer/markdown": "npm:@lezer/markdown@^1.7.2",
        "@std/assert": "jsr:@std/assert@^1.0.19",
        "@std/fmt": "jsr:@std/fmt@^1.0.10",
        "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
        "@std/path": "jsr:@std/path@1.0.6",
        "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
        "plist": "npm:plist@3.1.0",
        "regex": "npm:regex@^6.1.0",
        "valibot": "npm:valibot@^0.36.0"
    },
    "tasks": {
        "test": "deno test --allow-net=127.0.0.1 --allow-env=XDG_CONFIG_HOME,HOME,USERPROFILE packages/",
        "dev": "deno run -A --watch packages/llm-router/src/main.js --instance dev",
        "build": "deno run --allow-read --allow-write --allow-run=deno,tar scripts/build.js",
        "package": "deno run --allow-read --allow-write scripts/package.js",
        "deploy": "deno run --allow-read --allow-write --allow-env --allow-net=127.0.0.1 --allow-run scripts/deploy.js"
    },
    "fmt": {
        "useTabs": false,
        "indentWidth": 4,
        "proseWrap": "preserve",
        "exclude": ["**/node_modules/", "**/*.sh"]
    },
    "lint": {
        "rules": {
            "tags": ["recommended"]
        },
        "exclude": ["**/node_modules/"]
    },
    "unstable": ["no-legacy-abort"]
}
