{
    "workspace": [
        "./packages/cli",
        "./packages/core",
        "./packages/llm-router",
        "./packages/vram-mac-guard"
    ],
    "imports": {
        "@cliffy/prompt": "jsr:@cliffy/prompt@^1.2.1",
        "@hono/hono": "jsr:@hono/hono@^4.13.1",
        "@lezer/markdown": "npm:@lezer/markdown@^1.7.2",
        "@std/fmt": "jsr:@std/fmt@^1.0.10",
        "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
        "@std/path": "jsr:@std/path@1.0.6",
        "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
        "plist": "npm:plist@3.1.0",
        "regex": "npm:regex@^6.1.0",
        "valibot": "npm:valibot@^0.36.0"
    },
    "fmt": {
        "useTabs": false,
        "indentWidth": 4,
        "proseWrap": "preserve",
        "exclude": ["**/node_modules/", "**/*.sh"]
    },
    "lint": {
        "rules": {
            "tags": ["recommended"]
        },
        "exclude": ["**/node_modules/"]
    }
}
